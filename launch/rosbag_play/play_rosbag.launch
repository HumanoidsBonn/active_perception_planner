<?xml version="1.0"?>
<launch>
    <arg name="map_frame" default="world" />
    <arg name="rosbag_file" default="/home/rohit/data/glasshouse/2023_cka/2023-09-26-16-07-47.bag"/>
    <arg name="rate" default="1.0"/>
    <!-- <arg name="paused" default="false"/> -->
    <param name="/use_sim_time" type="bool" value="true" />
    
    <include file="$(find horti_description)/launch/model.launch"/>
    <!-- <include file="$(find active_perception_planner)/launch/publish_cloud.launch"/> -->

    <!-- remux static transforms -->
    <node name="static_transform_mux" type="static_transform_mux" pkg="static_transform_mux" />
    <node pkg="rosbag" type="play" name="player" output="screen" args="--clock --pause -r $(arg rate) $(arg rosbag_file) /yolo_segmentation_ros_node/result:=/old/result /yolo_segmentation_ros_node/visualization:=/old/visualization"/>
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find active_perception_planner)/config/rosbag.rviz"/>
    

</launch>
