<?xml version="1.0"?>
<launch>
    <node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager"/>

    <node name="depth_image_averaging" pkg="depth_image_averaging" type="depth_image_averaging_node" output="screen"> 
    <remap from="camera/depth/image_raw" to="/zed2i/depth/depth_registered"/>
    <remap from="camera/averaged_depth/image_raw" to="/zed2i/depth/depth_registered_avg"/>
    </node>
    <node pkg="nodelet" type="nodelet" name="point_cloud_xyzrgb" args="load depth_image_proc/point_cloud_xyzrgb nodelet_manager --no-bond">
        <remap from="rgb/camera_info" to="/zed2i/left/camera_info" />
        <remap from="rgb/image_rect_color" to="/zed2i/left/image_rect_color" />
        <remap from="depth_registered/image_rect" to="/zed2i/depth/depth_registered_avg" />
        <remap from="depth_registered/points" to="/zed2i/depth/points" />
        <!-- <param if="$(arg use_compressed)" name="image_transport" value="compressed" />
        <param if="$(arg use_compressed)" name="depth_image_transport" value="compressedDepth" /> -->
    </node>

    <node pkg="pointcloud_roi" type="filter_detected_roi_node" name="detect_roi" output="screen">
        <remap from="~pc" to="/zed2i/depth/points" />
        <remap from="~rgb" to="/zed2i/left/image_rect_color" />
        <remap from="~depth" to="/zed2i/depth/depth_registered_avg" />
        <remap from="~dets" to="/yolo_segmentation_ros_node/detections" />
        <remap from="~tracked_dets" to="/yolo_segmentation_ros_node/tracked_detections" />
        <remap from="~map_frame" to="trolley_local_link" />
    </node>

   
    
</launch>