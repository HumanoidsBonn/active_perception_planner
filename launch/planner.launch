<?xml version="1.0"?>
<launch>
<arg name="debug" default="true" />
<arg unless="$(arg debug)" name="launch_prefix" value="" />
<arg if="$(arg debug)"     name="launch_prefix" value="gdb -ex run --args" />
<!-- <arg name="config" default="$(find active_perception_planner)/config/ur_simulated_config.yaml"/> -->

<rosparam command="load" file="$(find active_perception_planner)/config/planner.yaml" />
<rosparam command="load" file="$(find active_perception_planner)/config/head_joint_states.yaml" />

<node name="laser_filter" pkg="sensor_filters" type="pointcloud2_filter_chain" output="screen">
  <rosparam command="load" file="$(find active_perception_planner)/config/zed2i_filter.yaml" />
  <remap from="~input" to="/zed2i/depth/points" />
  <remap from="~output" to="/zed2i/depth/points_filtered" />
</node>
<!-- <node pkg="capsicum_superellipsoid_detector" type="trigger_voxblox.py" name="trigger_voxblox" output="screen">
    <param name="service_name" value="/active_perciever/publish_pointclouds"/>
    <param name="rate" value="0.2"/>
  </node> -->


<node name="active_perciever" pkg="active_perception_planner" type="active_perciever" output="screen"  launch-prefix="$(arg launch_prefix)">
    <param name="use_fixed_pose"                value="false" />
    <param name="ofe/peduncle/buffer_size"      value="3" />
    <param name="use_exact_sync"                value="true" />
    <param name="disable_motion"                value="false" />
    <param name="wait_time"                     value="0.0" />
    <param name="disable_d405_processing"       value="true" />
    <remap from="~pc" to="/zed2i/depth/points_filtered" />
    <remap from="~rgb" to="/zed2i/left/image_rect_color" />
    <remap from="~depth" to="/zed2i/depth/depth_registered" />
    <remap from="~dets" to="/yolo_segmentation_ros_node/detections" />
    <remap from="~tracked_dets" to="/yolo_segmentation_ros_node/tracked_detections" />
    <remap from="~map_frame" to="trolley_local_link" />
    <!-- <rosparam command="load" file="$(arg config)" /> -->
    <!-- <rosparam command="load" file="$(find active_perception_planner)/config/pose_tracking_settings.yaml" /> -->
    <!-- <remap from="pointcloud" to="/zed2i/point_cloud/cloud_registered"/>
    <param name="use_freespace_pointcloud" value="false" />
    <param name="tsdf_voxel_size" value="0.005" />
    <param name="tsdf_voxels_per_side" value="64" />
    <param name="voxel_carving_enabled" value="true" />
    <param name="color_mode" value="color" />
    <param name="use_tf_transforms" value="true" />
    <param name="update_mesh_every_n_sec" value="1.0" />
    <param name="min_time_between_msgs_sec" value="0.0" />
    <param name="method" value="simple" />
    <param name="use_const_weight" value="false" />
    <param name="allow_clear" value="true" />
    <param name="verbose" value="false" />
    <param name="max_ray_length_m" value="2.0"/>
    <param name="enable_icp" value="false"/>
    <param name="icp_mini_batch_size" value="1000"/>
    <param name="accumulate_icp_corrections" value="false"/>
    <param name="publish_tsdf_info" value="true"/>
    <param name="publish_pointclouds" value="true" />
 -->
    
</node>
</launch>
