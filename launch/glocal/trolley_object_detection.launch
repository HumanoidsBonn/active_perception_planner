<?xml version="1.0"?>
<launch>

    <!-- User Python Env -->
    <!-- <arg name="yolo_segmentation_ros_python" value=""/> -->

    <!-- Virtual Python Env -->
    <arg name="yolo_segmentation_ros_python" value="$(env HOME)/.virtualenvs/yolo_segmentation_ros/bin/python3"/>

    <node name="camera1_yolo_segmentation_ros_node" pkg="yolo_segmentation_ros" type="cropped_peduncle_detection_ros_node.py" launch-prefix="$(arg yolo_segmentation_ros_python)" output="log">
        <remap from="input_image" to="/trollomatic/camera1/color/image_raw"/>
    </node>

    <node name="camera2_yolo_segmentation_ros_node" pkg="yolo_segmentation_ros" type="cropped_peduncle_detection_ros_node.py" launch-prefix="$(arg yolo_segmentation_ros_python)" output="log">
        <remap from="input_image" to="/trollomatic/camera2/color/image_raw"/>
    </node>

    <node name="camera3_yolo_segmentation_ros_node" pkg="yolo_segmentation_ros" type="cropped_peduncle_detection_ros_node.py" launch-prefix="$(arg yolo_segmentation_ros_python)" output="log">
        <remap from="input_image" to="/trollomatic/camera3/color/image_raw"/>
    </node> 

    <!-- <node name="d405_yolo_segmentation_ros_node" pkg="yolo_segmentation_ros" type="ros_node.py" launch-prefix="$(arg yolo_segmentation_ros_python)" output="log">
        <remap from="input_image" to="/head_camera_d405/color/image_raw"/> 
    </node>-->

</launch>