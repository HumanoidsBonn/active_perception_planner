<launch>
    <arg name="sensor_name" default="rosbag" />
    <arg name="visualize" default="false" />

    <arg name="debug" default="false" />
    <arg unless="$(arg debug)" name="launch_prefix" value="" />
    <arg if="$(arg debug)"     name="launch_prefix" value="gdb -ex run --args" />
    <!-- <node name="depth_segmentation_node" pkg="depth_segmentation" type="depth_segmentation_node" output="screen" launch-prefix="gdb -ex run args"> -->
  
    <node name="depth_segmentation_node" pkg="depth_segmentation" type="depth_segmentation_node" output="screen" launch-prefix="$(arg launch_prefix)">
      <rosparam command="load" file="$(find active_perception_planner)/cfg/$(arg sensor_name)_topics.yaml"/>
      <rosparam command="load" file="$(find active_perception_planner)/cfg/$(arg sensor_name)_config.yaml"/>
      <param name="semantic_instance_segmentation/enable" value="true"/>
      <param name="label_display" value="$(arg visualize)"/>
    </node>
  </launch>